{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "wave_index",
    "groups",
    "conditions",
    "announcement"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "wave_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enemy_id",
          "spawn_id",
          "route_id",
          "count",
          "start_seconds",
          "interval_seconds"
        ],
        "properties": {
          "enemy_id": {
            "type": "string",
            "enum": [
              "emberling",
              "wind_runner",
              "brush_cluster"
            ]
          },
          "spawn_id": {
            "type": "string",
            "enum": [
              "S_NORTH",
              "S_SOUTH"
            ]
          },
          "route_id": {
            "type": "string",
            "enum": [
              "NORTH",
              "SOUTH"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "start_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 48
          },
          "interval_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 48
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "condition_id",
          "start_seconds"
        ],
        "properties": {
          "condition_id": {
            "type": "string",
            "enum": [
              "gust_front"
            ]
          },
          "start_seconds": {
            "type": "integer",
            "minimum": 5,
            "maximum": 20
          }
        }
      }
    },
    "announcement": {
      "type": "string",
      "maxLength": 120
    }
  }
}