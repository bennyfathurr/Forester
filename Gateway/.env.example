# Export these in your shell or deployment environment. Never put provider keys in Unity.
FACTORY_PROVIDER=fake
FACTORY_SESSION_TOKEN=replace-with-session-token
PORT=8080
PROVIDER_TIMEOUT=3
# Only required with FACTORY_PROVIDER=openai; choose an account-accessible structured-output model.
OPENAI_MODEL=replace-with-supported-model-id
OPENAI_API_KEY=replace-with-server-only-key
